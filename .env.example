# Frontend container settings (frontend/docker-compose.yml)
FRONTEND_PORT=3000
# Where nginx proxies /api to. Default targets a backend running on the Docker host.
BACKEND_URL=http://host.docker.internal:8090
# 0.0.0.0 = reachable from the network; 127.0.0.1 = only through a reverse proxy on the same machine
FRONTEND_BIND=0.0.0.0
