# Rendered by the nginx image at start-up: ${BACKEND_URL} is substituted from the environment.

# Behind a host reverse proxy (HTTPS), keep the scheme the browser actually used.
map $http_x_forwarded_proto $ielts_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Speaking recordings are uploaded as multipart audio.
    client_max_body_size 60m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # The host (with port) and scheme the browser used, so the backend sees the real site address.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $ielts_forwarded_proto;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The app and its API are one site (this server), so /api calls are never cross-origin. Browsers still send
        # Origin on POST/PUT; dropping it stops the backend from mistaking them for CORS requests when the scheme or
        # port differs behind proxies. Auth is a bearer token (no cookies), so there is no CSRF exposure.
        proxy_set_header Origin "";
        # Grading, coach reports and plan personalisation can take a minute.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
